# Desarrollo local (no commitear el .env real). En Render: Environment Variables.
BOT_PROVIDER=coinmarketcap
BOT_BROKER=simulated
BOT_SYMBOLS=BTC
BOT_TIMEFRAMES=5m
BOT_BALANCE=50
BOT_QTY=0.01
BOT_COMMISSION=0.0005
BOT_SPREAD=0.0001
PORT=8000
HOST=0.0.0.0
BOT_LOG=INFO
# CoinMarketCap (recomendado):
CMC_API_KEY=tu-api-key-de-coinmarketcap
CMC_IDS=BTC:1,ETH:1027,PAXG:4705,SOL:5426
CMC_POLL_SECONDS=30
CMC_CATALOG_LIMIT=200
# Admin (obligatorio para endpoints admin):
ADMIN_TOKEN=tu-token-secreto-aqui
ADMIN_RATE_LIMIT=120
ADMIN_RATE_WINDOW=60
# PostgreSQL Neon (RENDER: configurar como Secret):
# DATABASE_URL=postgresql://neondb@...?sslmode=require
# Deriv (opcional):
# DERIV_TOKEN=
